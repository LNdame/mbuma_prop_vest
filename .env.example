# ─────────────────────────────────────────────────────────────
# Environment template — SAFE TO COMMIT (no real secrets here).
#
# Copy this to the environment-specific file you need and fill in values:
#   cp .env.example .env.development
#   cp .env.example .env.staging
#   cp .env.example .env.production
#
# The app selects a file by APP_ENV (falls back to NODE_ENV, then
# "development"). Each environment MUST use its own separate database.
# ─────────────────────────────────────────────────────────────
APP_ENV=development
NODE_ENV=development

# --- Database ---
DATABASE_URL='postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require'

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET='change_me'

# --- App URLs ---
APP_URL='http://localhost:3000'

# --- S3-compatible object storage ---
STORAGE_ENDPOINT='https://t3.storageapi.dev'
STORAGE_REGION='auto'
STORAGE_BUCKET='your-bucket'
STORAGE_ACCESS_KEY='your-access-key'
STORAGE_SECRET_KEY='your-secret-key'
STORAGE_PUBLIC_URL='https://t3.storageapi.dev/your-bucket'
